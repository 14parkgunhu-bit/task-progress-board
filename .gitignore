# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 파일 (사용자가 직접 확인 후 삭제)
/trash-can/

# bkit 플러그인 작업 기록 (자동 생성)
/.bkit/

# Claude Code 개인 설정 (사람마다 다름)
/.claude/settings.local.json


# Vercel CLI 연결 정보와 Vercel이 만든 .env.local (이미 위의 .env* 규칙으로도 제외됨)
.vercel
